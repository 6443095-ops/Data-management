      `;

      emptyState.classList.add("hidden");
      container.classList.remove("hidden");
      showToast(`Found details for ${member.name}!`, "success");
    }

    // ==========================================
    // ADMIN AUTHENTICATION & PIN MANAGEMENT
    // ==========================================
    function unlockAdmin() {
      const pin = document.getElementById("admin-pin-input").value.trim();
      if (pin === currentAdminPin) {
        document.getElementById("admin-lock-screen").classList.add("hidden");
        document.getElementById("admin-dashboard-content").classList.remove("hidden");
        showToast("Admin session unlocked", "success");
        renderAdminRoster();
        updateAdminStats();
      } else {
        showToast("Incorrect security PIN! Access denied.", "error");
      }
    }

    function lockAdmin() {
      document.getElementById("admin-pin-input").value = "";
      document.getElementById("admin-lock-screen").classList.remove("hidden");
      document.getElementById("admin-dashboard-content").classList.add("hidden");
      showToast("Admin locked");
    }

    // Toggle password eye visibility
    function togglePinVisibility(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (input.type === "password") {
        input.type = "text";
        icon.className = "fa-solid fa-eye-slash text-xs";
      } else {
        input.type = "password";
        icon.className = "fa-solid fa-eye text-xs";
      }
    }

    // Open Change/View PIN modal
    function openChangePinModal() {
      isPinRevealed = false;
      document.getElementById("current-pin-display").innerText = "••••••";
      document.getElementById("reveal-pin-text").innerText = "Show PIN";
      document.getElementById("inp-new-pin").value = "";
      document.getElementById("inp-confirm-pin").value = "";
      document.getElementById("pin-modal").classList.remove("hidden");
    }

    function closeChangePinModal() {
      document.getElementById("pin-modal").classList.add("hidden");
    }

    function toggleRevealCurrentPin() {
      isPinRevealed = !isPinRevealed;
      const display = document.getElementById("current-pin-display");
      const btnText = document.getElementById("reveal-pin-text");
      if (isPinRevealed) {
        display.innerText = currentAdminPin;
        btnText.innerText = "Hide PIN";
      } else {
        display.innerText = "••••••";
        btnText.innerText = "Show PIN";
      }
    }

    function handleUpdatePin(e) {
      e.preventDefault();
      const newPin = document.getElementById("inp-new-pin").value.trim();
      const confirmPin = document.getElementById("inp-confirm-pin").value.trim();

      if (newPin.length < 4) {
        showToast("PIN must be at least 4 digits long", "error");
        return;
      }

      if (newPin !== confirmPin) {
        showToast("New PIN and Confirm PIN do not match", "error");
        return;
      }

      currentAdminPin = newPin;
      localStorage.setItem(PIN_STORAGE_KEY, newPin);
      showToast("Security PIN updated successfully!", "success");
      closeChangePinModal();
    }

    // ==========================================
    // ADMIN FORM HANDLING (ADD & MODIFY)
    // ==========================================
    function handleFormSubmit(e) {
      e.preventDefault();

      const name = document.getElementById("inp-name").value.trim();
      const phone = document.getElementById("inp-phone").value.trim();
      const room = document.getElementById("inp-room").value.trim();
      const plan = document.getElementById("inp-plan").value;
      const diet = document.getElementById("inp-diet").value;
      const totalDays = parseInt(document.getElementById("inp-total-days").value) || 30;
      const consumedDays = parseInt(document.getElementById("inp-consumed-days").value) || 0;
      const fee = document.getElementById("inp-fee").value.trim();
      const payment = document.getElementById("inp-payment").value;
      const startDate = document.getElementById("inp-start-date").value || new Date().toISOString().split('T')[0];

      if (phone.length < 10) {
        showToast("Please enter a valid 10-digit mobile number", "error");
        return;
      }

      if (isEditing && currentEditPhone) {
        // UPDATE / MODIFY EXISTING RECORD
        const index = membersData.findIndex(m => m.phone === currentEditPhone);
        if (index !== -1) {
          // Keep attendance logs intact
          const existingLogs = membersData[index].attendance || [];

          membersData[index] = {
            ...membersData[index],
            name,
            phone,
            room,
            plan,
            diet,
            totalDays,
            consumedDays,
            fee,
            payment,
            startDate,
            attendance: existingLogs
          };

          saveToDisk();
          showToast(`Record updated for ${name}`, "success");
          resetFormToCreate();
        }
      } else {
        // CREATE NEW RECORD
        const exists = membersData.some(m => m.phone === phone);
        if (exists) {
          showToast("A member with this mobile number already exists! Use Edit button to alter.", "error");
          return;
        }

        const newMember = {
          name,
          phone,
          room,
          plan,
          diet,
          totalDays,
          consumedDays,
          fee: fee || 3000,
          payment,
          startDate,
          attendance: []
        };

        membersData.unshift(newMember);
        saveToDisk();
        showToast(`New member ${name} enrolled successfully!`, "success");
        resetFormToCreate();
      }

      renderAdminRoster();
      updateAdminStats();

      // If user had active lookup for this phone, refresh it
      const currentLookupPhone = document.getElementById("student-search-phone").value.trim();
      if (currentLookupPhone === phone) {
        handleStudentLookup();
      }
    }

    // Load member into form to edit / alter
    function loadMemberForEdit(phone) {
      const member = membersData.find(m => m.phone === phone);
      if (!member) return;

      isEditing = true;
      currentEditPhone = member.phone;

      // Populate Inputs
      document.getElementById("inp-name").value = member.name || '';
      document.getElementById("inp-phone").value = member.phone || '';
      document.getElementById("inp-room").value = member.room || '';
      document.getElementById("inp-plan").value = member.plan || 'Both Lunch & Dinner';
      document.getElementById("inp-diet").value = member.diet || 'Pure Veg';
      document.getElementById("inp-total-days").value = member.totalDays || 30;
      document.getElementById("inp-consumed-days").value = member.consumedDays || 0;
      document.getElementById("inp-fee").value = member.fee || 3000;
      document.getElementById("inp-payment").value = member.payment || 'Paid';
      document.getElementById("inp-start-date").value = member.startDate || new Date().toISOString().split('T')[0];

      // Update Form UI state
      document.getElementById("form-mode-title").innerText = `Modifying: ${member.name}`;
      document.getElementById("form-mode-badge").className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500 text-white mb-3";
      document.getElementById("btn-submit-text").innerText = "Save Modified Changes";
      document.getElementById("btn-cancel-edit").classList.remove("hidden");

      // Scroll to form smoothly
      document.getElementById("member-form").scrollIntoView({ behavior: 'smooth', block: 'start' });
      showToast(`Loaded ${member.name} for editing`, "info");
    }

    function resetFormToCreate() {
      isEditing = false;
      currentEditPhone = null;
      document.getElementById("member-form").reset();
      document.getElementById("inp-start-date").value = new Date().toISOString().split('T')[0];
      document.getElementById("inp-total-days").value = 30;
      document.getElementById("inp-consumed-days").value = 0;

      document.getElementById("form-mode-title").innerText = "Add New Member";
      document.getElementById("form-mode-badge").className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-100 text-brand-700 mb-3";
      document.getElementById("btn-submit-text").innerText = "Save New Member";
      document.getElementById("btn-cancel-edit").classList.add("hidden");
    }

    // Helper functions for days stepper inside form
    function adjustTotalDays(delta) {
      const inp = document.getElementById("inp-total-days");
      inp.value = Math.max(1, (parseInt(inp.value) || 0) + delta);
    }
    function adjustConsumedDays(delta) {
      const inp = document.getElementById("inp-consumed-days");
      inp.value = Math.max(0, (parseInt(inp.value) || 0) + delta);
    }

    // ==========================================
    // ATTENDANCE & DAYS CONTROLS
    // ==========================================
    // Quick Attendance Punch (+1 day consumed)
    function quickPunchDay(phone) {
      const index = membersData.findIndex(m => m.phone === phone);
      if (index === -1) return;

      const member = membersData[index];
      const total = parseInt(member.totalDays || 30);
      let consumed = parseInt(member.consumedDays || 0);

      if (consumed >= total) {
        showToast(`${member.name} has already used all ${total} days! Recharge to continue.`, "error");
        return;
      }

      consumed += 1;
      member.consumedDays = consumed;

      // Add log
      if (!member.attendance) member.attendance = [];
      const todayStr = new Date().toISOString().split('T')[0];
      member.attendance.unshift({
        date: todayStr,
        meal: member.plan || "Regular Meal",
        note: `Punch #${consumed} (${total - consumed} days left)`
      });

      saveToDisk();
      renderAdminRoster();
      updateAdminStats();
      showToast(`Punched attendance for ${member.name}! Days left: ${total - consumed}`, "success");

      // Refresh student view if displayed
      const currentLookupPhone = document.getElementById("student-search-phone").value.trim();
      if (currentLookupPhone === phone) {
        handleStudentLookup();
      }
    }

    // Quick Renewal / Recharge days for a member
    function quickRechargeDays(phone, daysToAdd) {
      const index = membersData.findIndex(m => m.phone === phone);
      if (index === -1) return;

      membersData[index].totalDays = (parseInt(membersData[index].totalDays) || 0) + daysToAdd;
      saveToDisk();
      renderAdminRoster();
      updateAdminStats();
      showToast(`Added +${daysToAdd} days to ${membersData[index].name}!`, "success");

      // Refresh student view if displayed
      const currentLookupPhone = document.getElementById("student-search-phone").value.trim();
      if (currentLookupPhone === phone) {
        handleStudentLookup();
      }
    }

    // Delete a member
    function deleteMember(phone) {
      const member = membersData.find(m => m.phone === phone);
      if (!member) return;

      // Safe confirmation using standard UI modal simulation / immediate confirm
      const confirmed = window.confirm(`Are you sure you want to remove ${member.name} (${member.phone}) from the database?`);
      if (confirmed) {
        membersData = membersData.filter(m => m.phone !== phone);
        saveToDisk();
        renderAdminRoster();
        updateAdminStats();
        showToast(`${member.name} deleted successfully.`, "info");

        // Clear lookup if same member was displayed
        const currentLookupPhone = document.getElementById("student-search-phone").value.trim();
        if (currentLookupPhone === phone) {
          document.getElementById("student-card-container").classList.add("hidden");
          document.getElementById("student-empty-state").classList.remove("hidden");
        }
      }
    }

    // ==========================================
    // ATTENDANCE LOG MODAL
    // ==========================================
    function openAttendanceModal(phone) {
      const member = membersData.find(m => m.phone === phone);
      if (!member) return;

      activeModalMember = member;

      document.getElementById("modal-member-name").innerText = member.name;
      document.getElementById("modal-member-phone").innerText = `+91 ${member.phone} • Room: ${member.room || 'N/A'}`;

      const total = parseInt(member.totalDays || 30);
      const consumed = parseInt(member.consumedDays || 0);
      const remaining = Math.max(0, total - consumed);

      document.getElementById("modal-total-punched").innerText = `${consumed} Days`;
      document.getElementById("modal-remaining-days").innerText = `${remaining} Days Left`;

      const logsBox = document.getElementById("modal-attendance-logs");
      logsBox.innerHTML = "";

      if (!member.attendance || member.attendance.length === 0) {
        logsBox.innerHTML = `
          <div class="text-center py-6 text-slate-400">
            <i class="fa-regular fa-calendar-xmark text-2xl mb-1"></i>
            <p>No punches recorded yet.</p>
          </div>
        `;
      } else {
        member.attendance.forEach((log, idx) => {
          logsBox.innerHTML += `
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-lg bg-orange-100 text-brand-700 font-bold flex items-center justify-center text-[10px]">
                  #${member.attendance.length - idx}
                </span>
                <div>
                  <strong class="text-slate-800">${log.date}</strong>
                  <span class="text-[11px] text-slate-500 block">${log.meal}</span>
                </div>
              </div>
              <span class="text-[11px] text-slate-400 font-medium">${log.note || 'Recorded'}</span>
            </div>
          `;
        });
      }

      document.getElementById("attendance-modal").classList.remove("hidden");
    }

    function closeAttendanceModal() {
      document.getElementById("attendance-modal").classList.add("hidden");
      activeModalMember = null;
    }

    function punchTodayFromModal() {
      if (!activeModalMember) return;
      quickPunchDay(activeModalMember.phone);
      openAttendanceModal(activeModalMember.phone); // Refresh modal view
    }

    // ==========================================
    // RENDER ADMIN ROSTER TABLE
    // ==========================================
    function renderAdminRoster() {
      const filter = (document.getElementById("admin-filter-query")?.value || "").toLowerCase().trim();
      const listContainer = document.getElementById("admin-roster-list");
      const countBadge = document.getElementById("roster-count-badge");

      if (!listContainer) return;

      const filtered = membersData.filter(m => 
        m.name.toLowerCase().includes(filter) || 
        m.phone.includes(filter) || 
        (m.room && m.room.toLowerCase().includes(filter))
      );

      countBadge.innerText = filtered.length;
      listContainer.innerHTML = "";

      if (filtered.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-10 text-slate-400 text-xs">
            <i class="fa-solid fa-user-slash text-2xl mb-1"></i>
            <p>No members match your search criteria.</p>
          </div>
        `;
        return;
      }

      filtered.forEach(m => {
        const total = parseInt(m.totalDays || 30);
        const consumed = parseInt(m.consumedDays || 0);
        const remaining = Math.max(0, total - consumed);

        // Warning class for remaining days
        let statusBadge = '';
        if (remaining === 0) {
          statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700">Expired</span>';
        } else if (remaining <= 3) {
          statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700">${remaining}d left!</span>`;
        } else {
          statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700">${remaining}d left</span>`;
        }

        const card = document.createElement("div");
        card.className = "p-3.5 bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:border-brand-300 transition space-y-2";
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <h4 class="font-bold text-slate-900 text-sm">${m.name}</h4>
                ${statusBadge}
              </div>
              <p class="text-xs text-slate-500 font-medium">
                <i class="fa-solid fa-phone text-[10px] text-slate-400"></i> ${m.phone} • Room: ${m.room || 'N/A'}
              </p>
            </div>
            
            <div class="text-right">
              <span class="text-xs font-black text-slate-800">${consumed} / ${total} Days</span>
              <span class="block text-[10px] text-slate-400 font-medium">${m.payment} (₹${m.fee || '3000'})</span>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-1.5 text-xs">
            <!-- Left: Attendance & Extension -->
            <div class="flex items-center gap-1.5">
              <button 
                onclick="quickPunchDay('${m.phone}')" 
                title="Punch 1 day meal attendance"
                class="px-2.5 py-1 bg-brand-50 hover:bg-brand-100 text-brand-700 border border-brand-200 rounded-lg text-xs font-bold transition flex items-center gap-1"
              >
                <i class="fa-solid fa-plus text-[10px]"></i> Punch Day
              </button>

              <button 
                onclick="openAttendanceModal('${m.phone}')" 
                title="View Attendance History"
                class="p-1.5 px-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold transition"
              >
                <i class="fa-solid fa-calendar-check text-[11px]"></i>
              </button>

              <button 
                onclick="quickRechargeDays('${m.phone}', 30)" 
                title="Renew for +30 days"
                class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 rounded-lg text-[11px] font-bold transition"
              >
                +30d Renew
              </button>
            </div>

            <!-- Right: Modify / Delete -->
            <div class="flex items-center gap-1.5">
              <button 
                onclick="loadMemberForEdit('${m.phone}')" 
                title="Modify data (fees, room, days, diet)"
                class="px-2.5 py-1 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-bold transition flex items-center gap-1"
              >
                <i class="fa-solid fa-pen-to-square text-[10px]"></i> Edit
              </button>

              <button 
                onclick="deleteMember('${m.phone}')" 
                title="Delete this record"
                class="p-1.5 px-2 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg text-xs font-bold transition"
              >
                <i class="fa-solid fa-trash-can text-[11px]"></i>
              </button>
            </div>
          </div>
        `;

        listContainer.appendChild(card);
      });
    }

    // ==========================================
    // STATS AGGREGATOR
    // ==========================================
    function updateAdminStats() {
      const totalCount = membersData.length;
      let expiringCount = 0;
      let pendingFeesCount = 0;
      let todayMealsCount = 0;
      const todayStr = new Date().toISOString().split('T')[0];

      membersData.forEach(m => {
        const total = parseInt(m.totalDays || 30);
        const consumed = parseInt(m.consumedDays || 0);
        const left = Math.max(0, total - consumed);

        if (left <= 3) expiringCount++;
        if (m.payment === 'Pending' || m.payment === 'Partial') pendingFeesCount++;

        if (m.attendance && m.attendance.some(a => a.date === todayStr)) {
          todayMealsCount++;
        }
      });

      document.getElementById("stat-total-members").innerText = totalCount;
      document.getElementById("stat-expiring").innerText = expiringCount;
      document.getElementById("stat-pending-fees").innerText = pendingFeesCount;
      document.getElementById("stat-today-meals").innerText = todayMealsCount;
    }

    // Window load bootstrap
    window.addEventListener("DOMContentLoaded", () => {
      initDatabase();
    });
  </script>

</body>
</html>
