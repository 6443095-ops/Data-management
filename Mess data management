    // Local Storage Keys
    const STORAGE_KEY = "annapurna_mess_members_v2";
    const PIN_STORAGE_KEY = "annapurna_admin_secure_pin";
    const DEFAULT_ADMIN_PIN = "1234"; // Default initial fallback PIN

    // Application State
    let membersData = [];
    let isEditing = false;
    let currentEditPhone = null;
    let activeModalMember = null;
    let currentAdminPin = DEFAULT_ADMIN_PIN;
    let isPinRevealed = false;

    // Load initial data & PIN
    function initDatabase() {
      // 1. Load Admin PIN
      const storedPin = localStorage.getItem(PIN_STORAGE_KEY);
      if (storedPin) {
        currentAdminPin = storedPin;
      } else {
        currentAdminPin = DEFAULT_ADMIN_PIN;
        localStorage.setItem(PIN_STORAGE_KEY, currentAdminPin);
      }

      // 2. Load Members
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        try {
          membersData = JSON.parse(stored);
        } catch (e) {
          membersData = INITIAL_MEMBERS;
          saveToDisk();
        }
      } else {
        membersData = INITIAL_MEMBERS;
        saveToDisk();
      }
      // Set today's date in form default
      document.getElementById('inp-start-date').value = new Date().toISOString().split('T')[0];
    }

    function saveToDisk() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(membersData));
    }

    // ==========================================
    // TAB NAVIGATION
    // ==========================================
    function switchMainTab(tab) {
      const viewLookup = document.getElementById("view-lookup");
      const viewAdmin = document.getElementById("view-admin");
      const btnLookup = document.getElementById("nav-btn-lookup");
      const btnAdmin = document.getElementById("nav-btn-admin");

      if (tab === 'lookup') {
        viewLookup.classList.remove("hidden");
        viewAdmin.classList.add("hidden");
        btnLookup.className = "px-4 py-2 rounded-xl transition duration-200 flex items-center gap-2 bg-white text-brand-600 shadow-sm";
        btnAdmin.className = "px-4 py-2 rounded-xl transition duration-200 flex items-center gap-2 text-slate-600 hover:text-brand-600";
