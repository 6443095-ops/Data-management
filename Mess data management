<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hotel Swadisht & Mess - Member & Attendance Portal</title>
  
  <!-- Google Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#fff7ed',
              100: '#ffedd5',
              200: '#fed7aa',
              300: '#fdba74',
              400: '#fb923c',
              500: '#f97316',
              600: '#ea580c',
              700: '#c2410c',
              800: '#9a3412',
              900: '#7c2d12',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background: radial-gradient(circle at 15% 15%, #fed7aa 0%, #fff7ed 40%, #f1f5f9 100%);
      min-height: 100vh;
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.7);
    }
    .glass-nav {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(12px);
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>

<body class="font-sans text-slate-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- TOP HEADER / BANNER -->
  <header class="w-full glass-nav border-b border-orange-100/60 sticky top-0 z-40 transition-all shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-3 sm:px-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand-600 to-amber-400 flex items-center justify-center text-white shadow-lg shadow-brand-500/30 transform -rotate-3">
          <i class="fa-solid fa-utensils text-lg"></i>
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2">
            Hotel Swadisht <span class="text-brand-600 font-black"> & Mess</span>
            <span class="text-[10px] font-bold uppercase tracking-wider bg-brand-100 text-brand-700 px-2 py-0.5 rounded-full hidden sm:inline-block">Smart Portal</span>
          </h1>
          <p class="text-xs text-slate-500 font-medium hidden sm:block">Daily Meal Track, Subscription Days & Attendance</p>
        </div>
      </div>

      <!-- Quick Switch Tabs -->
      <div class="flex p-1 bg-slate-100/80 rounded-2xl border border-slate-200/80 text-sm font-semibold">
        <button id="nav-btn-lookup" onclick="switchMainTab('lookup')" class="px-4 py-2 rounded-xl transition duration-200 flex items-center gap-2 bg-white text-brand-600 shadow-sm">
          <i class="fa-solid fa-magnifying-glass text-xs"></i>
          <span>Member Lookup</span>
        </button>
        <button id="nav-btn-admin" onclick="switchMainTab('admin')" class="px-4 py-2 rounded-xl transition duration-200 flex items-center gap-2 text-slate-600 hover:text-brand-600">
          <i class="fa-solid fa-shield-halved text-xs"></i>
          <span>Admin Control</span>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN BODY CONTENT -->
  <main class="max-w-5xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-8 flex-1">

    <!-- Toast Notification Message -->
    <div id="toast-notification" class="fixed top-20 right-4 sm:right-8 z-50 transform translate-y-[-100px] opacity-0 transition-all duration-300 pointer-events-none">
      <div id="toast-inner" class="px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 border text-sm font-semibold">
        <span id="toast-icon"></span>
        <span id="toast-text">Alert message</span>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 1: MEMBER / STUDENT LOOKUP INTERFACE -->
    <!-- ========================================== -->
    <section id="view-lookup" class="space-y-6">
      
      <!-- Lookup Input Banner -->
      <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-xl shadow-orange-950/5 border border-white">
        <div class="max-w-xl mx-auto text-center space-y-2 mb-6">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-100/70 px-3 py-1 rounded-full">
            <i class="fa-solid fa-bell-concierge"></i> Check Food Validity & Balance
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Check Your Mess Days & Attendance</h2>
          <p class="text-sm text-slate-500">Enter your 10-digit mobile number to see remaining days, meals taken, and subscription expiry.</p>
        </div>

        <div class="max-w-md mx-auto">
          <div class="relative flex items-center">
            <span class="absolute left-4 text-slate-400 font-bold text-sm">+91</span>
            <input 
              type="tel" 
              id="student-search-phone" 
              maxlength="10" 
              placeholder="e.g. 9876543210" 
              onkeydown="if(event.key === 'Enter') handleStudentLookup()"
              class="w-full pl-14 pr-28 py-3.5 bg-white rounded-2xl border-2 border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none text-slate-800 font-semibold placeholder:font-normal placeholder:text-slate-400 transition"
            />
            <button 
              onclick="handleStudentLookup()"
              class="absolute right-2 px-4 py-2 bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 text-white rounded-xl font-bold text-xs tracking-wide shadow-md shadow-brand-500/30 transition flex items-center gap-1.5 active:scale-95"
            >
              <span>Search</span>
              <i class="fa-solid fa-arrow-right text-[11px]"></i>
            </button>
          </div>
          <div class="flex items-center justify-between text-xs text-slate-400 mt-2 px-1">
            <span> <button type="button" onclick="quickFillPhone('9876543210')" class="text-brand-600 font-semibold underline"></button>, <button type="button" onclick="quickFillPhone('9123456789')" class="text-brand-600 font-semibold underline"></button></span>
          </div>
        </div>
      </div>

      <!-- Student Data Details Box (Dynamic) -->
      <div id="student-card-container" class="hidden">
        <!-- Rendered via JS -->
      </div>

      <!-- Empty State / Greeting Placeholder -->
      <div id="student-empty-state" class="text-center py-12 px-4 border-2 border-dashed border-slate-200/90 rounded-3xl bg-white/40">
        <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center text-brand-600 mx-auto text-2xl mb-3 shadow-inner">
          <i class="fa-solid fa-id-card-clip"></i>
        </div>
        <h4 class="text-base font-bold text-slate-700">No Member Selected</h4>
        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Please type your registered mobile number in the search bar above to view live days remaining and food history.</p>
      </div>

    </section>

    <!-- ========================================== -->
    <!-- VIEW 2: ADMIN CONTROL CENTER & MODIFIER   -->
    <!-- ========================================== -->
    <section id="view-admin" class="hidden space-y-6">

      <!-- Admin Passcode Gate (Private, only Admin knows/sets) -->
      <div id="admin-lock-screen" class="glass-card rounded-3xl p-8 max-w-md mx-auto text-center shadow-xl space-y-4">
        <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-inner">
          <i class="fa-solid fa-lock"></i>
        </div>
        <div>
          <h3 class="text-xl font-extrabold text-slate-800">Admin Authentication</h3>
          <p class="text-xs text-slate-500 mt-1">Restricted area for mess supervisor. Enter your private administrator PIN to proceed.</p>
        </div>
        <div class="space-y-3">
          <div class="relative">
            <input 
              type="password" 
              id="admin-pin-input" 
              maxlength="10" 
              placeholder="********"
              onkeydown="if(event.key === 'Enter') unlockAdmin()"
              class="w-full text-center tracking-widest text-xl font-bold py-3 bg-slate-50 rounded-2xl border-2 border-slate-200 focus:border-brand-500 focus:outline-none"
            />
            <button 
              type="button" 
              onclick="togglePinVisibility('admin-pin-input', 'lock-eye-icon')" 
              class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-sm"
              title="Show/Hide PIN"
            >
              <i id="lock-eye-icon" class="fa-solid fa-eye"></i>
            </button>
          </div>
          <button 
            onclick="unlockAdmin()"
            class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-2xl font-bold text-sm tracking-wide shadow-lg shadow-slate-900/20 transition active:scale-98"
          >
            Unlock Control Center
          </button>
        </div>
      </div>

      <!-- Admin Dashboard (Visible once unlocked) -->
      <div id="admin-dashboard-content" class="hidden space-y-6">

        <!-- Top Admin Stats & Quick Actions Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="glass-card p-4 rounded-2xl border border-white shadow-sm flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400">Total Members</p>
              <h4 id="stat-total-members" class="text-2xl font-extrabold text-slate-800">0</h4>
            </div>
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-base"><i class="fa-solid fa-users"></i></div>
          </div>

          <div class="glass-card p-4 rounded-2xl border border-white shadow-sm flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400">Expiring Soon (&lt;3 Days)</p>
              <h4 id="stat-expiring" class="text-2xl font-extrabold text-amber-600">0</h4>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-base"><i class="fa-solid fa-hourglass-half"></i></div>
          </div>

          <div class="glass-card p-4 rounded-2xl border border-white shadow-sm flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400">Pending Fees</p>
              <h4 id="stat-pending-fees" class="text-2xl font-extrabold text-rose-600">0</h4>
            </div>
            <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-base"><i class="fa-solid fa-indian-rupee-sign"></i></div>
          </div>

          <div class="glass-card p-4 rounded-2xl border border-white shadow-sm flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400">Today's Meals</p>
              <h4 id="stat-today-meals" class="text-2xl font-extrabold text-emerald-600">0</h4>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-base"><i class="fa-solid fa-bowl-rice"></i></div>
          </div>
        </div>

        <!-- 2 Columns: Add/Edit Form & Live Members Roster -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

          <!-- Left Column: Add / Modify Member Form (5 Cols) -->
          <div class="lg:col-span-5 space-y-4">
            <div class="glass-card rounded-3xl p-6 shadow-xl border border-white relative overflow-hidden">
              <div id="form-mode-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-100 text-brand-700 mb-3">
                <i class="fa-solid fa-user-plus"></i> <span id="form-mode-title">Add New Member</span>
              </div>

              <!-- Reset to New Button (Visible in Edit Mode) -->
              <button 
                id="btn-cancel-edit" 
                onclick="resetFormToCreate()" 
                class="hidden absolute top-6 right-6 text-xs text-slate-500 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg font-semibold transition"
              >
                <i class="fa-solid fa-xmark mr-1"></i> Cancel Edit
              </button>

              <form id="member-form" onsubmit="handleFormSubmit(event)" class="space-y-3.5 text-xs">
                
                <div>
                  <label class="font-bold text-slate-700 mb-1 block">Full Name *</label>
                  <input type="text" id="inp-name" required placeholder="e.g. Rahul Patil" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-slate-800 font-semibold outline-none text-sm transition" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="font-bold text-slate-700 mb-1 block">Mobile Number *</label>
                    <input type="tel" id="inp-phone" required maxlength="10" placeholder="10 digits" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-slate-800 font-semibold outline-none text-sm transition" />
                  </div>
                  <div>
                    <label class="font-bold text-slate-700 mb-1 block">Room / Hostel No.</label>
                    <input type="text" id="inp-room" placeholder="e.g. B-204" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-slate-800 font-semibold outline-none text-sm transition" />
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="font-bold text-slate-700 mb-1 block">Meal Plan</label>
                    <select id="inp-plan" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:border-brand-500 outline-none text-slate-800 font-medium bg-white text-xs">
                      <option value="Both Lunch & Dinner">Lunch + Dinner (2 Meals)</option>
                      <option value="Lunch Only">Lunch Only</option>
                      <option value="Dinner Only">Dinner Only</option>
                      <option value="Full Day (3 Meals)">Full Day (Breakfast+L+D)</option>
                    </select>
                  </div>
                  <div>
                    <label class="font-bold text-slate-700 mb-1 block">Diet Preference</label>
                    <select id="inp-diet" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:border-brand-500 outline-none text-slate-800 font-medium bg-white text-xs">
                      <option value="Pure Veg">Pure Veg</option>
                      <option value="Veg + Non-Veg Days">Veg + Non-Veg Days</option>
                      <option value="Jain / Swaminarayan">Jain / Swaminarayan</option>
                    </select>
                  </div>
                </div>

                <!-- Days tracking alteration controls -->
                <div class="p-3 bg-amber-50/70 rounded-2xl border border-amber-200/70 space-y-2.5">
                  <span class="font-black text-amber-900 uppercase tracking-wider text-[10px] block flex items-center justify-between">
                    <span>Days & Validity Management</span>
                    <i class="fa-solid fa-calculator text-amber-600"></i>
                  </span>

                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="text-[11px] font-bold text-amber-950 block">Total Subscribed Days</label>
                      <input type="number" id="inp-total-days" min="1" max="365" value="30" required class="w-full px-3 py-2 rounded-xl border border-amber-300 bg-white font-bold text-slate-800 outline-none text-sm" />
                    </div>
                    <div>
                      <label class="text-[11px] font-bold text-amber-950 block">Days Consumed (Used)</label>
                      <input type="number" id="inp-consumed-days" min="0" max="365" value="0" required class="w-full px-3 py-2 rounded-xl border border-amber-300 bg-white font-bold text-slate-800 outline-none text-sm" />
                    </div>
                  </div>

                  <!-- Quick recharge buttons -->
                  <div class="flex items-center gap-2 pt-1">
                    <span class="text-[10px] text-amber-800 font-semibold">Quick Add Days:</span>
                    <button type="button" onclick="adjustTotalDays(15)" class="px-2.5 py-1 bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 rounded-lg text-[10px] font-bold transition">+15 Days</button>
                    <button type="button" onclick="adjustTotalDays(30)" class="px-2.5 py-1 bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 rounded-lg text-[10px] font-bold transition">+30 Days</button>
                    <button type="button" onclick="adjustConsumedDays(-1)" title="Undo 1 day consumed" class="px-2.5 py-1 bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 rounded-lg text-[10px] font-bold transition">-1 Day</button>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="font-bold text-slate-700 mb-1 block">Monthly Fee (₹)</label>
                    <input type="number" id="inp-fee" placeholder="3200" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-brand-500 font-bold text-slate-800 text-sm outline-none" />
                  </div>
                  <div>
                    <label class="font-bold text-slate-700 mb-1 block">Payment Status</label>
                    <select id="inp-payment" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:border-brand-500 font-bold bg-white text-xs outline-none">
                      <option value="Paid">Paid</option>
                      <option value="Pending">Pending</option>
                      <option value="Partial">Partial</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label class="font-bold text-slate-700 mb-1 block">Subscription Start Date</label>
                  <input type="date" id="inp-start-date" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:border-brand-500 text-xs font-semibold outline-none" />
                </div>

                <div class="pt-2">
                  <button 
                    type="submit" 
                    id="btn-form-submit" 
                    class="w-full py-3 bg-gradient-to-r from-brand-600 to-amber-500 hover:from-brand-700 hover:to-amber-600 text-white font-bold rounded-2xl shadow-lg shadow-brand-600/30 transition text-sm flex items-center justify-center gap-2 active:scale-98"
                  >
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span id="btn-submit-text">Save New Member</span>
                  </button>
                </div>

              </form>
            </div>
          </div>

          <!-- Right Column: Member Roster, Attendance Quick Punch & Actions (7 Cols) -->
          <div class="lg:col-span-7 space-y-4">
            <div class="glass-card rounded-3xl p-6 shadow-xl border border-white">
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                    <span>Manage Mess Members</span>
                    <span id="roster-count-badge" class="text-xs bg-slate-200 text-slate-700 px-2 py-0.5 rounded-full font-bold">0</span>
                  </h3>
                  <p class="text-xs text-slate-400">Punch today's meals, alter details, or renew members.</p>
                </div>
                <!-- Search Filter in Roster -->
                <div class="w-full sm:w-auto relative">
                  <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-slate-400"></i>
                  <input 
                    type="text" 
                    id="admin-filter-query" 
                    oninput="renderAdminRoster()" 
                    placeholder="Search name/phone..." 
                    class="w-full sm:w-48 pl-8 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-brand-500"
                  />
                </div>
              </div>

              <!-- Roster List Container -->
              <div id="admin-roster-list" class="space-y-3 max-h-[580px] overflow-y-auto pr-1">
                <!-- Injected via JavaScript -->
              </div>
            </div>
          </div>

        </div>

        <!-- Admin Settings & Security Control Row -->
        <div class="glass-card rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs border border-white">
          <div class="flex items-center gap-2 text-slate-600">
            <i class="fa-solid fa-shield-cat text-brand-600 text-base"></i>
            <span>Administrator Security Controls & PIN Management</span>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="openChangePinModal()" class="px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-900 rounded-xl font-bold transition flex items-center gap-1.5">
              <i class="fa-solid fa-key"></i> View / Change Security PIN
            </button>
            <button onclick="lockAdmin()" class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-bold transition flex items-center gap-1.5">
              <i class="fa-solid fa-lock"></i> Lock Session
            </button>
          </div>
        </div>

      </div>

    </section>

  </main>

  <!-- ATTENDANCE HISTORY MODAL -->
  <div id="attendance-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="glass-card w-full max-w-lg rounded-3xl p-6 shadow-2xl border border-white relative max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-orange-100 text-brand-600 flex items-center justify-center text-lg font-bold">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div>
            <h3 id="modal-member-name" class="font-extrabold text-slate-900 text-base">Attendance History</h3>
            <p id="modal-member-phone" class="text-xs text-slate-400 font-semibold"></p>
          </div>
        </div>
        <button onclick="closeAttendanceModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <div class="py-4 flex items-center justify-between bg-amber-50/70 p-3 rounded-2xl my-3 text-xs border border-amber-100">
        <div>
          <span class="text-slate-500 block">Total Days Punched</span>
          <strong id="modal-total-punched" class="text-sm font-extrabold text-amber-800">0 Days</strong>
        </div>
        <div>
          <span class="text-slate-500 block">Days Left to Eat</span>
          <strong id="modal-remaining-days" class="text-sm font-extrabold text-brand-600">0 Days</strong>
        </div>
        <div>
          <button id="modal-quick-punch-btn" onclick="punchTodayFromModal()" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl font-bold text-xs shadow-sm transition">
            + Punch Today
          </button>
        </div>
      </div>

      <div class="overflow-y-auto flex-1 pr-1">
        <h4 class="text-xs font-bold text-slate-700 mb-2 uppercase tracking-wider">Punch Log</h4>
        <div id="modal-attendance-logs" class="space-y-2 text-xs">
          <!-- Injected via JS -->
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 text-right">
