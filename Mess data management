    // ==========================================
    // TOAST NOTIFICATIONS
    // ==========================================
    let toastTimeout = null;
    function showToast(msg, type = "info") {
      const container = document.getElementById("toast-notification");
      const inner = document.getElementById("toast-inner");
      const icon = document.getElementById("toast-icon");
      const text = document.getElementById("toast-text");

      text.innerText = msg;

      if (type === "success") {
        inner.className = "px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 border text-sm font-semibold bg-emerald-600 text-white border-emerald-500";
        icon.className = "fa-solid fa-circle-check";
      } else if (type === "error") {
        inner.className = "px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 border text-sm font-semibold bg-rose-600 text-white border-rose-500";
        icon.className = "fa-solid fa-triangle-exclamation";
      } else {
        inner.className = "px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 border text-sm font-semibold bg-slate-800 text-white border-slate-700";
        icon.className = "fa-solid fa-circle-info";
      }

      container.classList.remove("translate-y-[-100px]", "opacity-0");
      container.classList.add("translate-y-0", "opacity-100");

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        container.classList.remove("translate-y-0", "opacity-100");
        container.classList.add("translate-y-[-100px]", "opacity-0");
      }, 3000);
    }

    // ==========================================
    // STUDENT / MEMBER LOOKUP
    // ==========================================
    function quickFillPhone(phone) {
      document.getElementById("student-search-phone").value = phone;
      handleStudentLookup();
    }

    function handleStudentLookup() {
      const phoneInput = document.getElementById("student-search-phone").value.trim();
      const container = document.getElementById("student-card-container");
      const emptyState = document.getElementById("student-empty-state");

