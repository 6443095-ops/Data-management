            <div>
              <span class="text-slate-400 block font-semibold">Diet Type</span>
              <strong class="text-slate-800 font-bold">${member.diet || 'Regular'}</strong>
            </div>
            <div>
              <span class="text-slate-400 block font-semibold">Monthly Mess Fee</span>
              <strong class="text-slate-800 font-bold">₹${member.fee || '3000'}</strong>
            </div>
            <div>
              <span class="text-slate-400 block font-semibold">Payment Status</span>
              <strong class="${member.payment === 'Paid' ? 'text-emerald-600' : 'text-rose-600'} font-bold">${member.payment || 'Paid'}</strong>
            </div>
          </div>

          <!-- Attendance Log Shortcut -->
          <div class="flex items-center justify-between pt-2">
            <span class="text-xs text-slate-500 font-medium">Want to see all your meal attendance logs?</span>
            <button onclick="openAttendanceModal('${member.phone}')" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5">
              <i class="fa-solid fa-list-check"></i> View Attendance History
            </button>
