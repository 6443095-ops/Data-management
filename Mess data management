                <h3 class="text-2xl font-extrabold text-slate-900">${member.name}</h3>
                <span class="text-xs px-2.5 py-1 rounded-full font-bold border ${statusColor}">
                  ${statusText}
                </span>
              </div>
              <p class="text-xs text-slate-500 font-medium mt-1">
                <i class="fa-solid fa-phone text-slate-400 mr-1"></i> +91 ${member.phone} 
                ${member.room ? `• <i class="fa-solid fa-door-closed text-slate-400 mx-1"></i> Room: ${member.room}` : ''}
              </p>
            </div>
            <div class="sm:text-right">
              <span class="text-xs text-slate-400 font-medium block">Subscription Period</span>
              <span class="text-sm font-bold text-slate-800">Started on ${member.startDate || 'N/A'}</span>
            </div>
          </div>

          <!-- Highlight Days Left Display -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-200/60 text-center">
              <span class="text-xs text-amber-900 font-bold uppercase tracking-wider block">Remaining Food Days</span>
              <strong class="text-4xl font-black text-amber-700">${remaining}</strong>
              <span class="text-xs text-amber-800 font-semibold block mt-0.5">Days Left to Eat</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/60 text-center">
              <span class="text-xs text-slate-500 font-bold uppercase tracking-wider block">Meals Taken (Used)</span>
              <strong class="text-4xl font-black text-slate-800">${consumed}</strong>
              <span class="text-xs text-slate-500 font-semibold block mt-0.5">Days Punched</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/60 text-center">
              <span class="text-xs text-slate-500 font-bold uppercase tracking-wider block">Total Days Plan</span>
              <strong class="text-4xl font-black text-slate-800">${total}</strong>
              <span class="text-xs text-slate-500 font-semibold block mt-0.5">Plan Validity</span>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-xs font-bold text-slate-600">
              <span>Days Consumed Progress</span>
              <span>${percent}% used</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
              <div class="h-full bg-gradient-to-r from-amber-500 to-brand-600 rounded-full transition-all duration-500" style="width: ${percent}%"></div>
